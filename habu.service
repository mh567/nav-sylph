[Unit]
Description=Habu - Personal Digital Workbench
Documentation=https://github.com/mh567/habu
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/habu

ExecStart=/usr/bin/node server.js
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

Environment=NODE_ENV=production
Environment=SERVER_HOST=127.0.0.1
Environment=SERVER_PORT=4000
EnvironmentFile=-/opt/habu/.env

StandardOutput=append:/opt/habu/logs/server.log
StandardError=append:/opt/habu/logs/server.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/habu/logs /opt/habu/config.json /opt/habu/.admin-password.json -/opt/habu/habu.db -/opt/habu/habu.db-wal -/opt/habu/habu.db-shm

[Install]
WantedBy=multi-user.target
