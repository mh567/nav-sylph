# Navigation Page 服务器配置
# 复制此文件为 .env 并根据需要修改

# ===== 服务器配置 =====
# 监听地址 (默认: 127.0.0.1，仅本地访问)
# 设置为 0.0.0.0 允许外部访问
SERVER_HOST=127.0.0.1

# 监听端口 (默认: 4000)
SERVER_PORT=4000

# ===== HTTPS 配置 (可选) =====
# 是否启用 HTTPS (true/false)
HTTPS_ENABLED=false

# SSL/TLS 证书路径 (HTTPS_ENABLED=true 时必填)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_CA_PATH=

# ===== 安全配置 =====
# 管理员密码文件路径 (默认: .admin-password.json)
ADMIN_PASSWORD_FILE=.admin-password.json

# 登录 Cookie 的 Secure 标记由服务端自动判断：请求经 https 到达才加，
# 纯 http 部署自动省略。无需修改本项，仅在需要覆盖自动判断时改动。
COOKIE_SECURE=true

# 是否用 IP 归属地辅助判断登录环境是否变化 (默认: true)
GEO_ENABLED=true

# 地理比对粒度: province | city | off (默认: province)
# 市级噪声较大（移动基站在相邻城市间漂移），一般不需要改
GEO_SCOPE=province

# ===== 路径配置 =====
# 书签数据文件 (默认: data.json)
DATA_FILE=data.json

# 日志目录 (默认: logs)
LOG_DIR=logs

# 图标路径
ICON_PATH=icon.svg
FAVICON_PATH=favicon.svg

# ===== WebDAV 远程备份 (可选) =====
# WebDAV 配置存储在 .webdav-config.json 中（密码加密存储）
# 通过管理面板配置，无需在此设置
# WEBDAV_CONFIG_FILE=.webdav-config.json

# 「自动同步」的防抖窗口（毫秒，默认 30000）。开启自动同步后，配置、书签或
# 模块设置的连续改动会合并成一次上传；这个值是合并窗口，一般不需要改。
# 仅供端到端测试压到秒级使用。
# NAV_AUTO_SYNC_DELAY_MS=30000
